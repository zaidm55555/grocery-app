# Copy to .env.local (gitignored) and fill in. EXPO_PUBLIC_ values are inlined
# into the app bundle at build time, so they are NOT secret.
#
# AI mode talks to BasketBuddy's AI proxy (backend/ai-proxy), never to Groq
# directly: the Groq key lives only in the Worker's secrets, not here.
#
# The Worker URL printed by `wrangler deploy` (base URL; /chat is added for you).
EXPO_PUBLIC_AI_PROXY_URL=
# Must equal the Worker's APP_TOKEN secret. Extractable from any app build, so it
# only blocks casual abuse; the proxy's rate limit and allow-list do the rest.
EXPO_PUBLIC_AI_PROXY_TOKEN=

# PostHog values are public and inlined into the app bundle at build time.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
