{
  "cli": {
    "version": ">= 22.0.0"
  },
  "build": {
    "production": {
      "android": {
        "buildType": "apk",
        "distribution": "internal",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "ios": {
        "simulator": false
      },
      "channel": "production"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "distribution": "internal",
      "channel": "preview"
    },
    "simulator": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "distribution": "internal",
      "channel": "simulator"
    }
  }
}
